{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memora.local/schemas/pilot-question.schema.json",
  "title": "T24 draft-only pilot question envelope",
  "description": "A review envelope around a future T12 QuestionImportBundle. Drafts have question.source_class = null and are offline-only. Only an approved envelope may be converted by backend/src/memora/modules/questions/pilot_validation.py. The JSON Schema is the structural contract; that Python validator and T12 validate_question_import() are the semantic authorities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_id",
    "source",
    "question",
    "answer_verification",
    "review",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pilot_id": {
      "type": "string",
      "pattern": "^PILOT-PHYS-[0-9]{4}-P[12]-Q[0-9]{1,2}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "question": {
      "$ref": "#/$defs/question"
    },
    "answer_verification": {
      "$ref": "#/$defs/answerVerification"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "publication": {
      "$ref": "#/$defs/publication"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "question": {
            "properties": {
              "validation_status": {
                "const": "draft"
              }
            },
            "required": [
              "validation_status"
            ]
          }
        },
        "required": [
          "question"
        ]
      },
      "then": {
        "properties": {
          "question": {
            "properties": {
              "source_class": {
                "type": "null"
              },
              "reviewer_principal": {
                "type": "null"
              },
              "rubric": {
                "properties": {
                  "status": {
                    "const": "draft"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "concept_mappings": {
                "items": {
                  "properties": {
                    "provenance_type": {
                      "enum": [
                        "analyst_mapping",
                        "source_analysis"
                      ]
                    }
                  }
                }
              }
            },
            "required": [
              "source_class",
              "reviewer_principal",
              "rubric",
              "concept_mappings"
            ]
          },
          "answer_verification": {
            "properties": {
              "independent_review_status": {
                "const": "pending"
              },
              "reviewer_ref": {
                "type": "null"
              }
            },
            "required": [
              "independent_review_status",
              "reviewer_ref"
            ]
          },
          "review": {
            "properties": {
              "academic_review_status": {
                "const": "pending"
              },
              "reviewer_principal": {
                "type": "null"
              },
              "reviewer_qualification_ref": {
                "type": "null"
              },
              "reviewed_at": {
                "type": "null"
              },
              "ambiguity_status": {
                "const": "pending"
              },
              "duplicate_status": {
                "const": "pending"
              },
              "independence_declaration_ref": {
                "type": "null"
              }
            },
            "required": [
              "academic_review_status",
              "reviewer_principal",
              "reviewer_qualification_ref",
              "reviewed_at",
              "ambiguity_status",
              "duplicate_status",
              "independence_declaration_ref"
            ]
          },
          "publication": {
            "properties": {
              "approved_for_import": {
                "const": false
              },
              "approved_by": {
                "type": "null"
              },
              "approved_at": {
                "type": "null"
              },
              "import_batch_id": {
                "type": "null"
              }
            },
            "required": [
              "approved_for_import",
              "approved_by",
              "approved_at",
              "import_batch_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "question": {
            "properties": {
              "validation_status": {
                "const": "approved"
              }
            },
            "required": [
              "validation_status"
            ]
          }
        },
        "required": [
          "question"
        ]
      },
      "then": {
        "properties": {
          "question": {
            "properties": {
              "source_class": {
                "const": "expert_verified"
              },
              "author_principal": {
                "$ref": "#/$defs/uuid"
              },
              "reviewer_principal": {
                "$ref": "#/$defs/uuid"
              },
              "rubric": {
                "properties": {
                  "status": {
                    "const": "approved"
                  },
                  "evidence_ceiling": {
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "status",
                  "evidence_ceiling"
                ]
              },
              "concept_mappings": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "mapping_role": {
                      "const": "primary"
                    }
                  },
                  "required": [
                    "mapping_role"
                  ]
                },
                "minContains": 1,
                "items": {
                  "properties": {
                    "provenance_type": {
                      "const": "pilot_review"
                    }
                  }
                }
              }
            },
            "required": [
              "source_class",
              "author_principal",
              "reviewer_principal",
              "rubric",
              "concept_mappings"
            ]
          },
          "answer_verification": {
            "properties": {
              "independent_review_status": {
                "const": "verified"
              },
              "reviewer_ref": {
                "type": "string",
                "minLength": 1
              },
              "official_key_claimed": {
                "const": false
              }
            },
            "required": [
              "independent_review_status",
              "reviewer_ref",
              "official_key_claimed"
            ]
          },
          "review": {
            "properties": {
              "academic_review_status": {
                "const": "approved"
              },
              "reviewer_principal": {
                "$ref": "#/$defs/uuid"
              },
              "reviewer_qualification_ref": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "ambiguity_status": {
                "const": "cleared"
              },
              "duplicate_status": {
                "const": "cleared"
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              },
              "independence_declaration_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "academic_review_status",
              "reviewer_principal",
              "reviewer_qualification_ref",
              "reviewed_at",
              "ambiguity_status",
              "duplicate_status",
              "content_hash",
              "source_ref",
              "independence_declaration_ref"
            ]
          },
          "publication": {
            "properties": {
              "approved_for_import": {
                "const": true
              },
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "approved_for_import",
              "approved_by",
              "approved_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_type": {
                "const": "past_paper"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "question": {
            "properties": {
              "validation_status": {
                "const": "approved"
              }
            },
            "required": [
              "validation_status"
            ]
          }
        },
        "required": [
          "source",
          "question"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "reproduction_status": {
                "const": "approved"
              },
              "transcription_verified": {
                "const": true
              }
            },
            "required": [
              "reproduction_status",
              "transcription_verified"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "nullableUuid": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "document_filename",
        "document_sha256",
        "exam_year",
        "exam_label",
        "paper",
        "question_number",
        "pdf_page",
        "medium",
        "official_key_status",
        "reproduction_status",
        "reproduction_approval_ref",
        "licence_note",
        "transcription_verified"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^(SL-DOE-AL-PHYS-[0-9]{4}-P1|SYNTHETIC-[A-Z0-9-]+)$"
        },
        "source_type": {
          "enum": [
            "past_paper",
            "synthetic"
          ]
        },
        "document_filename": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "document_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "exam_year": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 2017,
              "maximum": 2025
            },
            {
              "type": "null"
            }
          ]
        },
        "exam_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "paper": {
          "oneOf": [
            {
              "const": "Paper I"
            },
            {
              "type": "null"
            }
          ]
        },
        "question_number": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            {
              "type": "null"
            }
          ]
        },
        "pdf_page": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "medium": {
          "const": "English"
        },
        "official_key_status": {
          "enum": [
            "not_found",
            "not_published",
            "marking_scheme_not_mcq_key",
            "unknown",
            "not_applicable"
          ]
        },
        "reproduction_status": {
          "enum": [
            "unapproved",
            "approved",
            "not_applicable"
          ]
        },
        "reproduction_approval_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "licence_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "transcription_verified": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "past_paper"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "document_filename": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "document_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "exam_year": {
                "type": "integer",
                "minimum": 2017,
                "maximum": 2025
              },
              "paper": {
                "const": "Paper I"
              },
              "question_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "pdf_page": {
                "type": "integer",
                "minimum": 1
              },
              "official_key_status": {
                "enum": [
                  "not_found",
                  "not_published",
                  "marking_scheme_not_mcq_key",
                  "unknown"
                ]
              },
              "reproduction_status": {
                "enum": [
                  "unapproved",
                  "approved"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "synthetic"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "document_filename": {
                "type": "null"
              },
              "document_sha256": {
                "type": "null"
              },
              "exam_year": {
                "type": "null"
              },
              "exam_label": {
                "const": "synthetic"
              },
              "paper": {
                "type": "null"
              },
              "question_number": {
                "type": "null"
              },
              "pdf_page": {
                "type": "null"
              },
              "official_key_status": {
                "const": "not_applicable"
              },
              "reproduction_status": {
                "const": "not_applicable"
              },
              "reproduction_approval_ref": {
                "type": "null"
              },
              "transcription_verified": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_code",
        "subject_id",
        "curriculum_version_id",
        "source_class",
        "target_source_class",
        "question_type",
        "prompt",
        "explanation",
        "validation_status",
        "author_principal",
        "reviewer_principal",
        "content",
        "options",
        "rubric",
        "concept_mappings"
      ],
      "properties": {
        "question_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subject_id": {
          "$ref": "#/$defs/uuid"
        },
        "curriculum_version_id": {
          "$ref": "#/$defs/uuid"
        },
        "source_class": {
          "oneOf": [
            {
              "const": "expert_verified"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_source_class": {
          "const": "expert_verified"
        },
        "question_type": {
          "const": "mcq"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "validation_status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "author_principal": {
          "$ref": "#/$defs/nullableUuid"
        },
        "reviewer_principal": {
          "$ref": "#/$defs/nullableUuid"
        },
        "content": {
          "$ref": "#/$defs/choiceContent"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "rubric": {
          "$ref": "#/$defs/rubric"
        },
        "concept_mappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/conceptMapping"
          }
        }
      }
    },
    "choiceContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "selection_mode"
      ],
      "properties": {
        "kind": {
          "const": "choice"
        },
        "schema_version": {
          "const": "1"
        },
        "selection_mode": {
          "const": "single"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_key",
        "display_text",
        "is_correct",
        "display_order"
      ],
      "properties": {
        "option_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "display_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "is_correct": {
          "type": "boolean"
        },
        "display_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubric_type",
        "max_score",
        "evidence_ceiling",
        "status",
        "payload"
      ],
      "properties": {
        "rubric_type": {
          "const": "exact"
        },
        "max_score": {
          "const": 1
        },
        "evidence_ceiling": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "schema_version"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "schema_version": {
              "const": "1"
            }
          }
        }
      }
    },
    "conceptMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_version_id",
        "mapping_role",
        "weight",
        "provenance_type",
        "provenance_ref"
      ],
      "properties": {
        "concept_version_id": {
          "$ref": "#/$defs/uuid"
        },
        "learning_objective_id": {
          "$ref": "#/$defs/nullableUuid"
        },
        "mapping_role": {
          "enum": [
            "primary",
            "supporting",
            "prerequisite",
            "misconception"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance_type": {
          "enum": [
            "analyst_mapping",
            "source_analysis",
            "pilot_review"
          ]
        },
        "provenance_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "answerVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_option_keys",
        "derivation",
        "independent_review_status",
        "reviewer_ref",
        "official_key_claimed",
        "notes"
      ],
      "properties": {
        "derived_option_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        },
        "derivation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "independent_review_status": {
          "enum": [
            "pending",
            "verified",
            "rejected"
          ]
        },
        "reviewer_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "official_key_claimed": {
          "const": false
        },
        "notes": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "academic_review_status",
        "reviewer_principal",
        "reviewer_qualification_ref",
        "review_scope",
        "reviewed_at",
        "ambiguity_status",
        "duplicate_status",
        "coverage_note",
        "content_hash",
        "source_ref",
        "independence_declaration_ref"
      ],
      "properties": {
        "academic_review_status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer_principal": {
          "$ref": "#/$defs/nullableUuid"
        },
        "reviewer_qualification_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "review_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "reviewed_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "ambiguity_status": {
          "enum": [
            "pending",
            "cleared",
            "flagged"
          ]
        },
        "duplicate_status": {
          "enum": [
            "pending",
            "cleared",
            "duplicate"
          ]
        },
        "coverage_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "content_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "independence_declaration_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_for_import",
        "approved_by",
        "approved_at",
        "import_batch_id"
      ],
      "properties": {
        "approved_for_import": {
          "type": "boolean"
        },
        "approved_by": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "approved_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
