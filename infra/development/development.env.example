# Compose deployment controls. GitHub Actions supplies the image tag.
MEMORA_IMAGE_TAG=development
MEMORA_ENV_FILE=./development.env.example
MEMORA_DEV_DOMAIN=dev-api.example.com

# Application configuration. Real values live only on the VPS in a mode-600 file.
MEMORA_ENVIRONMENT=development
MEMORA_LOG_LEVEL=INFO
MEMORA_DATABASE_URL=postgresql+psycopg://memora_dev:replace-me@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
MEMORA_SUPABASE_URL=https://example.supabase.co
MEMORA_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
MEMORA_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
MEMORA_RECENT_AUTH_WINDOW_SECONDS=600
MEMORA_DEVICE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
MEMORA_DEVICE_FINGERPRINT_KEY=replace-with-base64-32-byte-key
MEMORA_CONSENT_TERMS_VERSION=development-v1
MEMORA_CONSENT_PRIVACY_VERSION=development-v1
MEMORA_CONSENT_MATERIAL_PROCESSING_VERSION=development-v1
MEMORA_CONSENT_MODEL_PROCESSING_VERSION=development-v1
MEMORA_CONSENT_NOTIFICATIONS_VERSION=development-v1
MEMORA_OBJECT_STORAGE_PROVIDER=s3
MEMORA_OBJECT_STORAGE_ENDPOINT=https://replace-with-private-object-storage.example.com
MEMORA_OBJECT_STORAGE_REGION=us-east-1
MEMORA_OBJECT_STORAGE_BUCKET=memora-development-private
MEMORA_OBJECT_STORAGE_ACCESS_KEY=replace-with-storage-access-key
MEMORA_OBJECT_STORAGE_SECRET_KEY=replace-with-storage-secret-key
