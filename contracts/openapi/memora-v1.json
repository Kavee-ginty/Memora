{
  "components": {
    "headers": {
      "X-Correlation-ID": {
        "description": "Effective correlation identifier echoed by the server.",
        "schema": {
          "type": "string"
        }
      },
      "X-Request-ID": {
        "description": "Support and tracing identifier.",
        "schema": {
          "type": "string"
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "description": "Client-generated key scoped to the principal and operation.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 255,
          "minLength": 16,
          "type": "string"
        }
      },
      "IfNoneMatch": {
        "description": "ETag cache validation for optional reads.",
        "in": "header",
        "name": "If-None-Match",
        "required": false,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "AsyncOperation": {
        "properties": {
          "resource_id": {
            "format": "uuid",
            "title": "Resource Id",
            "type": "string"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "status": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Status",
            "type": "string"
          },
          "status_url": {
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "^/",
            "title": "Status Url",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "resource_id",
          "status",
          "status_url",
          "retry_after_seconds",
          "updated_at"
        ],
        "title": "AsyncOperation",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "action": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Field Errors",
            "type": "array"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "field_errors",
          "retryable",
          "retry_after_seconds",
          "action"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "examples": [
          {
            "error": {
              "action": "correct_input",
              "code": "validation_failed",
              "field_errors": [
                {
                  "code": "invalid_time",
                  "field": "preferred_time",
                  "message": "Enter a valid local time."
                }
              ],
              "message": "Check the highlighted fields and try again.",
              "request_id": "01J0000000000000000000000",
              "retry_after_seconds": null,
              "retryable": false
            }
          }
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "field": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "default": "ok"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "IdempotencyHeaders": {
        "properties": {
          "Idempotency-Key": {
            "maxLength": 255,
            "minLength": 16,
            "title": "Idempotency-Key",
            "type": "string"
          }
        },
        "required": [
          "Idempotency-Key"
        ],
        "title": "IdempotencyHeaders",
        "type": "object"
      },
      "PageMeta": {
        "properties": {
          "has_more": {
            "title": "Has More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "next_cursor",
          "has_more"
        ],
        "title": "PageMeta",
        "type": "object"
      },
      "PageParams": {
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "PageParams",
        "type": "object"
      },
      "RequestHeaders": {
        "properties": {
          "Accept-Language": {
            "anyOf": [
              {
                "maxLength": 35,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Accept-Language"
          },
          "X-Client-Version": {
            "maxLength": 50,
            "minLength": 1,
            "title": "X-Client-Version",
            "type": "string"
          },
          "X-Correlation-ID": {
            "format": "uuid",
            "title": "X-Correlation-Id",
            "type": "string"
          },
          "X-Platform": {
            "enum": [
              "android",
              "ios"
            ],
            "title": "X-Platform",
            "type": "string"
          }
        },
        "required": [
          "X-Correlation-ID",
          "X-Client-Version",
          "X-Platform"
        ],
        "title": "RequestHeaders",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Short-lived OIDC-issued access token.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Memora API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "healthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Correlation-ID": {
                "description": "Effective correlation identifier echoed by the server.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Support and tracing identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "healthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-Correlation-ID": {
                "description": "Effective correlation identifier echoed by the server.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Support and tracing identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness checks.",
      "name": "health"
    },
    {
      "description": "Authentication session and device lifecycle.",
      "name": "session"
    },
    {
      "description": "Student profile, preferences and consent status.",
      "name": "profile"
    },
    {
      "description": "Subjects, learning paths and concept progress.",
      "name": "curriculum"
    },
    {
      "description": "Learning material ingestion and status.",
      "name": "learning-updates"
    },
    {
      "description": "Extraction verification and learning-path commit.",
      "name": "verification"
    },
    {
      "description": "Daily missions, items, attempts and results.",
      "name": "missions"
    },
    {
      "description": "Seabed, reef and learning statistics.",
      "name": "progress"
    },
    {
      "description": "Reward inventory and placement.",
      "name": "rewards"
    },
    {
      "description": "Question reports and dispute status.",
      "name": "reports"
    },
    {
      "description": "Export and account-deletion workflows.",
      "name": "privacy"
    }
  ]
}
