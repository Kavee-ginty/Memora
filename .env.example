# Local development only. Copy this file to .env and never commit .env.
# Development, staging and production receive configuration from the platform
# secret manager, not from repository files. See docs/operations/environments.md.
MEMORA_ENVIRONMENT=local
MEMORA_LOG_LEVEL=INFO
MEMORA_API_PORT=8000
# This value is for commands run on the host (Alembic, seed, tests). Compose
# builds the API and worker URL from POSTGRES_* with the service host `postgres`.
MEMORA_DATABASE_URL=postgresql+psycopg://memora:change-for-local-only@127.0.0.1:5432/memora
# Supabase Auth with Google OAuth. Use the publishable key, never the service-role key.
MEMORA_SUPABASE_URL=https://your-project-ref.supabase.co
MEMORA_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
MEMORA_SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
MEMORA_RECENT_AUTH_WINDOW_SECONDS=600
# Base64-encoded independent 32-byte keys. Production values come from the secret manager.
MEMORA_DEVICE_ENCRYPTION_KEY=replace-with-base64-32-byte-key
MEMORA_DEVICE_FINGERPRINT_KEY=replace-with-base64-32-byte-key
# Replace these placeholders only after the matching policy text is approved.
MEMORA_CONSENT_TERMS_VERSION=unapproved-local-v1
MEMORA_CONSENT_PRIVACY_VERSION=unapproved-local-v1
MEMORA_CONSENT_MATERIAL_PROCESSING_VERSION=unapproved-local-v1
MEMORA_CONSENT_MODEL_PROCESSING_VERSION=unapproved-local-v1
MEMORA_CONSENT_NOTIFICATIONS_VERSION=unapproved-local-v1
POSTGRES_DB=memora
POSTGRES_USER=memora
POSTGRES_PASSWORD=change-for-local-only
POSTGRES_PORT=5432
