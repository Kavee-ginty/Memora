# Local development only. Copy this file to .env and never commit .env.
# Development, staging and production receive configuration from the platform
# secret manager, not from repository files. See docs/operations/environments.md.
MEMORA_ENVIRONMENT=local
MEMORA_LOG_LEVEL=INFO
MEMORA_API_PORT=8000
# Inside Compose, the API reaches PostgreSQL through the service host `postgres`.
# Commands run on the Windows host (Alembic, seed, tests) must use 127.0.0.1, for example:
# postgresql+psycopg://memora:change-for-local-only@127.0.0.1:5432/memora
MEMORA_DATABASE_URL=postgresql+psycopg://memora:change-for-local-only@postgres:5432/memora
POSTGRES_DB=memora
POSTGRES_USER=memora
POSTGRES_PASSWORD=change-for-local-only
POSTGRES_PORT=5432
